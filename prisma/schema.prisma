generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  phone      String?
  password   String
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  bookings   Booking[]
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Tour {
  id          String    @id @default(cuid())
  title       String
  price       Int
  description String
  duration    String
  location    String
  image       String
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Expedition {
  id          String    @id @default(cuid())
  title       String
  price       Int
  description String
  duration    String
  location    String
  difficulty  String
  image       String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id           String      @id @default(cuid())
  userId       String
  tourId       String?
  expeditionId String?
  name         String
  email        String
  persons      Int         @default(1)
  days         Int         @default(1)
  totalPrice   Int         @default(0)
  createdAt    DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id])
  tour       Tour?       @relation(fields: [tourId], references: [id])
  expedition Expedition? @relation(fields: [expeditionId], references: [id])
}
